# Base URL of the API as seen from the browser. Leave empty in production (same origin).
# For local development the API runs on port 3000 and the web app on 3001.
NEXT_PUBLIC_API_URL=http://localhost:3000

# Optional: URL the web server uses to reach the API for server-side fetches
# (template gallery, limits). Useful inside Docker Compose, e.g. http://api:3000.
# API_INTERNAL_URL=http://api:3000
