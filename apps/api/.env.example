# --- Required in production -------------------------------------------------
# Comma-separated API keys: name:secret[,name2:secret2]. Names show up in logs.
API_KEYS=dev:change-me
# Public base URL used in links and the OpenAPI servers list.
PUBLIC_URL=http://localhost:3000

# --- Storage and compiler ---------------------------------------------------
# Where workspaces and artifacts live inside the API process.
DATA_DIR=./.data
# Same directory as the Docker daemon sees it (only differs when the API runs in a container).
# HOST_DATA_DIR=/opt/latex-api/data
COMPILER_IMAGE=latex-compiler:dev
# COMPILER_RUNTIME=runsc
# COMPILER_SECCOMP_PROFILE=/app/seccomp/clsi-profile.json
# COMPILER_USER=1000:1000
# DOCKER_SOCKET=/var/run/docker.sock
TEMPLATES_DIR=../../packages/templates/templates

# --- Database (optional in development; required for durable async jobs) ---
# DATABASE_URL=postgresql://latex:latex@localhost:5432/latex

# --- Limits ------------------------------------------------------------------
MAX_UPLOAD_BYTES=50MB
MAX_UNPACKED_BYTES=200MB
MAX_FILES=500
SYNC_TIMEOUT_MS=60000
JOB_TIMEOUT_MS=300000
JOB_TIMEOUT_MAX_MS=600000
JOB_MEMORY=2GB
JOB_CPUS=2
JOB_PIDS=64
MAX_CONCURRENT_JOBS=2
ARTIFACT_TTL_HOURS=24
RATE_LIMIT_PER_KEY_PER_HOUR=60
RATE_LIMIT_CONCURRENT_PER_KEY=5
DEMO_RATE_LIMIT_PER_MINUTE=5
DEMO_RATE_LIMIT_PER_DAY=30
LOG_LEVEL=info
