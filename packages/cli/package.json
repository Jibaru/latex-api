{
  "name": "@jibaru/latex-api-cli",
  "version": "0.2.2",
  "description": "Agent-first command-line client for the LaTeX API: compile projects to PDF, sign in from the terminal, manage tokens and profiles, run async jobs, scaffold templates.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jibaru/latex-api.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/jibaru/latex-api#readme",
  "bugs": {
    "url": "https://github.com/jibaru/latex-api/issues"
  },
  "keywords": [
    "latex",
    "pdf",
    "tex",
    "cli",
    "compile",
    "pdflatex",
    "xelatex",
    "lualatex",
    "agent",
    "ai-agent",
    "skill"
  ],
  "bin": {
    "latex-api": "./dist/cli.mjs",
    "ltx": "./dist/cli.mjs"
  },
  "files": [
    "dist",
    "dist/skill/SKILL.md",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown && node scripts/copy-skill.mjs",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "build:binaries": "bash scripts/build-binaries.sh"
  },
  "dependencies": {
    "@jibaru/latex-api-sdk": "workspace:^",
    "@napi-rs/keyring": "^2.1.2",
    "chokidar": "^6.0.0",
    "citty": "^0.2.2",
    "fflate": "^0.8.3",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@latex-api/config": "workspace:*",
    "@latex-api/openapi": "workspace:^",
    "@types/node": "^22.0.0",
    "tsdown": "^0.23.1",
    "typescript": "^5.9.0",
    "vitest": "^5.0.5"
  }
}
