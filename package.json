{
  "name": "latex-api-monorepo",
  "private": true,
  "packageManager": "pnpm@9.13.2",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "openapi": "turbo run openapi",
    "changeset": "changeset",
    "release": "turbo run build --filter=./packages/sdk --filter=./packages/cli && changeset publish"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@changesets/cli": "^3.0.3",
    "turbo": "^2.11.10",
    "typescript": "^5.9.0"
  }
}
